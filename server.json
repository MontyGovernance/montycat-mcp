{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MontyGovernance/montycat-mcp",
  "title": "Montycat MCP - Shared Memory for AI Agents",
  "description": "Shared, persistent memory for AI agents, with semantic recall and live updates.",
  "repository": {
    "url": "https://github.com/MontyGovernance/montycat-mcp",
    "source": "github"
  },
  "version": "1.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "montycat-mcp",
      "version": "1.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MONTYCAT_URI",
          "description": "Optional Montycat engine URI: montycat://user:password@host:port/store",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MONTYCAT_TLS",
          "description": "Set to true when connecting to a TLS-enabled remote Montycat engine",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "docker.io/montygovernance/montycat-mcp:1.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MONTYCAT_URI",
          "description": "Optional Montycat engine URI: montycat://user:password@host:port/store",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MONTYCAT_TLS",
          "description": "Set to true when connecting to a TLS-enabled remote Montycat engine",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
